{
  "name": "browse-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Owned browser-automation gateway fronting a headful-under-Xvfb Patchright/real-Chrome stealth core.",
  "type": "module",
  "bin": {
    "obscura": "./dist/cli/obscura.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:stealth": "npm run build && node scripts/validate-stealth.mjs",
    "validate:http": "npm run build && node scripts/validate-http.mjs",
    "validate:frame-capture": "npm run build && node scripts/validate-frame-capture.mjs",
    "validate:vault-roundtrip": "npm run build && node scripts/validate-vault-roundtrip.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.12",
    "otplib": "^13.4.1",
    "patchright": "^1.60.0",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.7.0"
  }
}
