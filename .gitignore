# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Environment & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local-only context (private fleet/deployment detail kept out of this public repo)
*.local.md
*.local.*

# Security audit reports — map the gateway's security surfaces; keep local, never commit (public repo)
audit/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local agent config — machine-local Claude Code settings (e.g. operator-scoped permission grants);
# never commit to this public repo.
.claude/

# Browser / runtime artifacts
.cache/
playwright-report/
test-results/

# Fingerprint-parity snapshots (carry egress IPs / per-host detail — never commit; public repo)
*.fp.json
fingerprint-*.json

# Compound Engineering machine-local config
.compound-engineering/*.local.yaml
# The committed example is config.example.yaml, which the rule above never matched.

# Compound Engineering local scratch
.context/compound-engineering/

# U1: the build-time deploy stamp is baked into the image, never committed.
.deploy-id
