# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Environment & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local-only context (private fleet/deployment detail kept out of this public repo)
*.local.md
*.local.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Browser / runtime artifacts
.cache/
playwright-report/
test-results/

# Compound Engineering machine-local config
.compound-engineering/*.local.yaml
# ...but keep the committed example (the broad *.local.* rule above would hide it)
!.compound-engineering/config.local.example.yaml
